<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Who Serves First?"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginBottom="48dp" />

    <!-- A giant coin emoji that will change into text when tossed -->
    <TextView
        android:id="@+id/tvTossResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🪙"
        android:textSize="100sp"
        android:textAlignment="center"
        android:layout_marginBottom="48dp" />

    <Button
        android:id="@+id/btnTossCoin"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="Toss Coin"
        android:textSize="24sp"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnContinueToss"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Continue to Signup"
        android:textSize="18sp"
        android:visibility="gone" /> <!-- Hidden until the coin is tossed -->

</LinearLayout>