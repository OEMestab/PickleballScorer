<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. Background Image with centerCrop to prevent stretching -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/court_bg"
        android:scaleType="centerCrop" />

    <!-- 2. Dark tint overlay (40% opacity black) to ensure text readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <!-- 3. Your original UI content centered on top -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Game Mode"
            android:textSize="32sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.02"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="How are we playing today?"
            android:textSize="16sp"
            android:textColor="#E0E0E0"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="48dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSinglesMode"
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:text="👤  Singles"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            app:backgroundTint="#801E1E1E"
            app:cornerRadius="24dp"
            app:strokeColor="#FFFFFF"
            app:strokeWidth="2dp"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDoublesMode"
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:text="👥  Doubles"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            app:backgroundTint="#E62E7D32"
            app:cornerRadius="24dp"
            android:elevation="8dp" />

    </LinearLayout>
</FrameLayout>